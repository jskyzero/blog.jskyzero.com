---
import { Icon } from '@astrojs/starlight/components';

const { lang, editUrl, lastUpdated } = Astro.locals.starlightRoute;
---

<footer class="doc">
  <div class="meta sl-flex">
    <div>
      {
        editUrl && (
          <a href={editUrl} target="_blank" rel="noopener noreferrer" class="sl-flex">
            <Icon name="pencil" size="1em" />
            编辑此页
          </a>
        )
      }
    </div>
    <div>
      {
        lastUpdated && (
          <p title="最近更新">
            最近更新：<time datetime={lastUpdated.toISOString()}>
              {lastUpdated.toLocaleDateString(lang, { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
          </p>
        )
      }
      <p>&copy; {new Date().getFullYear()} jskyzero</p>
    </div>
  </div>
</footer>

<style>
  footer.doc {
    margin-top: 3rem;
    border-top: 1px solid var(--color-border-weak);
  }

  .meta {
    gap: 0.75rem 3rem;
    justify-content: space-between;
    flex-wrap: wrap;
    margin-block: 3rem 1.5rem;
    font-size: var(--sl-text-sm);
  }

  @media (min-width: 30rem) {
    .meta {
      flex-direction: row;
    }
  }

  .doc a,
  .doc p {
    padding-block: 0.125rem;
  }

  .doc a {
    gap: 0.4375rem;
    align-items: center;
    text-decoration: none;
    color: var(--color-text-weak);
    font-size: var(--sl-text-sm);
  }

  .doc a:hover {
    color: var(--color-text-strong);
  }

  .doc a svg {
    opacity: 0.85;
  }

  .doc p {
    color: var(--color-text-weak);
  }

  @media (min-width: 30rem) {
    .doc p {
      text-align: right;
    }
  }
</style>
