---
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { title, date, image, tags, category, description } = post.data;
---

<BaseLayout
  title={title}
  description={description}
  image={image}
>
  <div class="post-layout">
    <article class="post-main">
      <header class="post-header">
        <h1>{title}</h1>
        <div class="post-meta">
          <time datetime={date.toISOString()}>
            {date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
          <span class="post-category">
            <a href={`/tags/${category}`}>{category}</a>
          </span>
        </div>
        {
          tags.length > 0 && (
            <div class="post-tags">
              {tags.map(tag => (
                <a href={`/tags/${tag}`} class="tag">{tag}</a>
              ))}
            </div>
          )
        }
        {image && (
          <img
            src={image}
            alt={title}
            class="post-cover"
            loading="eager"
          />
        )}
      </header>
      <div class="post-content">
        <slot />
      </div>
    </article>
    <aside class="post-sidebar">
      <TableOfContents />
    </aside>
  </div>
</BaseLayout>

<style>
  .post-layout {
    display: flex;
    gap: 3rem;
  }

  .post-main {
    flex: 1;
    min-width: 0;
  }

  .post-sidebar {
    flex-shrink: 0;
    width: 14rem;
    padding-top: 24px;
  }

  @media (max-width: 900px) {
    .post-sidebar {
      display: none;
    }
  }

  .toc-sidebar {
    position: sticky;
    top: calc(var(--header-padding, 24px) * 2 + 3.5rem);
  }

  .toc-sidebar h2 {
    font-size: 14px;
    font-weight: 500;
    color: var(--color-text-strong);
    margin: 0 0 12px 0;
    padding: 0;
  }

  .toc-sidebar ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .toc-sidebar li {
    padding: 4px 0;
  }

  .toc-sidebar li[style*="--depth: 1"] {
    padding-left: 12px;
  }

  .toc-sidebar a {
    display: block;
    width: 100%;
    font-size: 14px;
    color: var(--color-text-weak);
    opacity: 0.5;
    text-decoration: none;
    padding: 4px 0;
    transition: opacity 0.15s;
  }

  .toc-sidebar a:hover {
    opacity: 0.8;
  }

  .toc-sidebar a.active {
    color: var(--color-text-strong);
    opacity: 1;
  }
</style>
