---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts'))
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title="jskyzero's blog">
  <section class="home-hero">
    <h1>jskyzero's blog</h1>
    <p>用来分享编程与计算机科学相关的内容。</p>
  </section>

  <section>
    <h2 class="section-title">最近文章</h2>
    <ul class="posts-list">
      {posts.slice(0, 10).map(post => (
        <li class="post-item">
          <h2><a href={`/posts/${post.slug}`}>{post.data.title}</a></h2>
          <div class="post-item-meta">
            <time datetime={post.data.date.toISOString()}>
              {post.data.date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
            <span>{post.data.category}</span>
          </div>
          {post.data.description && (
            <p class="post-item-desc">{post.data.description}</p>
          )}
        </li>
      ))}
    </ul>
    {posts.length > 10 && (
      <p class="view-all">
        <a href="/posts">查看全部 {posts.length} 篇文章</a>
      </p>
    )}
  </section>
</BaseLayout>
